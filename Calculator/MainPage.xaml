<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Calculator.MainPage"
             BackgroundColor="#1C1C1E">

    <Grid RowDefinitions="*, 2*" Padding="20" RowSpacing="10">

       <Label x:Name="Display"
               Grid.Row="0"
               Text="0"
               TextColor="White"
               FontSize="64"
               HorizontalOptions="End"
               VerticalOptions="End"
               LineBreakMode="NoWrap"
               Padding="10"/>

       <Grid Grid.Row="1" 
              RowDefinitions="*, *, *, *" 
              ColumnDefinitions="*, *, *, *"
              RowSpacing="10" 
              ColumnSpacing="10">

     
            <Button Text="7" Grid.Row="0" Grid.Column="0" FontSize="28" 
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="8" Grid.Row="0" Grid.Column="1" FontSize="28" 
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="9" Grid.Row="0" Grid.Column="2" FontSize="28" 
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="÷" Grid.Row="0" Grid.Column="3" FontSize="32" 
                    BackgroundColor="#FF9F0A" TextColor="White" CornerRadius="40" Clicked="OnOperationClicked"/>

        
            <Button Text="4" Grid.Row="1" Grid.Column="0" FontSize="28" 
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="5" Grid.Row="1" Grid.Column="1" FontSize="28" 
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="6" Grid.Row="1" Grid.Column="2" FontSize="28"
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="×" Grid.Row="1" Grid.Column="3" FontSize="32" 
                    BackgroundColor="#FF9F0A" TextColor="White" CornerRadius="40" Clicked="OnOperationClicked"/>

            
                <Button Text="1" Grid.Row="2" Grid.Column="0" FontSize="28"
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="2" Grid.Row="2" Grid.Column="1" FontSize="28" 
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="3" Grid.Row="2" Grid.Column="2" FontSize="28" 
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="-" Grid.Row="2" Grid.Column="3" FontSize="32" 
                    BackgroundColor="#FF9F0A" TextColor="White" CornerRadius="40" Clicked="OnOperationClicked"/>

    
            <Button Text="C" Grid.Row="3" Grid.Column="0" FontSize="28" 
                    BackgroundColor="#A5A5A5" TextColor="Black" CornerRadius="40" Clicked="OnClearClicked"/>
            <Button Text="0" Grid.Row="3" Grid.Column="1" FontSize="28" 
                    BackgroundColor="#3A3A3C" TextColor="White" CornerRadius="40" Clicked="OnNumberClicked"/>
            <Button Text="=" Grid.Row="3" Grid.Column="2" FontSize="32" 
                    BackgroundColor="#FF9F0A" TextColor="White" CornerRadius="40" Clicked="OnCalculateClicked"/>
            <Button Text="+" Grid.Row="3" Grid.Column="3" FontSize="32" 
                    BackgroundColor="#FF9F0A" TextColor="White" CornerRadius="40" Clicked="OnOperationClicked"/>
        </Grid>


    </Grid>


</ContentPage>
